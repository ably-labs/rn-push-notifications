# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-firebase requires Firebase iOS SDKs to be built as static frameworks
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

target 'RNPushExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # RNFB pods fail to compile as framework modules against React Native's
  # prebuilt core (non-modular React header imports). Build them as static
  # libraries instead — same as expo-build-properties' forceStaticLinking
  # (https://github.com/invertase/react-native-firebase/issues/8657).
  pre_install do |installer|
    installer.pod_targets.each do |pod|
      if ['RNFBApp', 'RNFBMessaging'].include?(pod.name)
        def pod.build_type
          Pod::BuildType.static_library
        end
      end
    end
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react-native-firebase pods import React headers non-modularly, which is a
    # hard error when built as frameworks (use_frameworks!)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end
end
